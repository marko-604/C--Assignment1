  rankdir="LR";
  Node0 [id="Node000000",label="TargetSelectionStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_target_selection_strategy.html",tooltip="Abstract base class for tower target selection strategies."];
  Node0 -> Node1 [id="edge15_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="FarthestTargetStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_farthest_target_strategy.html",tooltip="Strategy for selecting the farthest critter from the tower."];
  Node0 -> Node2 [id="edge16_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="HighestHealthTargetStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_highest_health_target_strategy.html",tooltip="Strategy for selecting the critter with the highest health."];
  Node0 -> Node3 [id="edge17_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="LowestHealthTargetStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_lowest_health_target_strategy.html",tooltip="Strategy for selecting the critter with the lowest health."];
  Node0 -> Node4 [id="edge18_Node000000_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="StrongestTargetStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_strongest_target_strategy.html",tooltip="Strategy for selecting the strongest critter based on strength value."];
  Node0 -> Node5 [id="edge19_Node000000_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="WeakestTargetStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_weakest_target_strategy.html",tooltip="Strategy for selecting the weakest critter based on strength value."];
}
