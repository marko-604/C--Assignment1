digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="Observer",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_observer.html",tooltip="Interface for all observers in the Observer pattern."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="CritterObserver",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_critter_observer.html",tooltip="Concrete observer for monitoring updates to Critter subjects."];
  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="MapObserver",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_map_observer.html",tooltip="Concrete observer that listens to updates from a Subject (typically a Map)."];
  Node0 -> Node3 [id="edge3_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="TowerObserver",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_tower_observer.html",tooltip="Concrete observer for monitoring Tower-related changes."];
}
